{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/opt/launch-video/**": "allow",
      "/runtime-assets/**": "allow",
      "/runtime-state/**": "allow",
      "/workbench/**": "allow",
      "/outbox/**": "allow",
      "/tmp/**": "allow"
    },
    "skill": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "task": "deny"
  },
  "provider": {
    "openrouter": {
      "models": {
        "anthropic/claude-opus-5.5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "options": {
            "reasoning": {
              "enabled": true
            }
          },
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.2,
            "cache_write": 5
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}